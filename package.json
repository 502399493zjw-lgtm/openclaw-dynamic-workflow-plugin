{
  "name": "openclaw-plugin-workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist", "openclaw.plugin.json"],
  "openclaw": {
    "extensions": ["./src/index.ts"],

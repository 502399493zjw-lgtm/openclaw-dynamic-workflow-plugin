  "peerDependencies": { "openclaw": "*" },
  "dependencies": {
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "openclaw": "2026.6.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
